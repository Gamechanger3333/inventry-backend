 Copy this file to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/nexus_db"

# JWT signing secret — run: openssl rand -hex 32
JWT_SECRET="change-this-to-a-random-secret"

# Server port (default: 8080)
PORT=8080

# Optional: Groq API key for AI Assistant feature
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Node environment
NODE_ENV=development

# Resend (email sending) — get a free key at https://resend.com
# No domain needed: sandbox sender onboarding@resend.dev works out of the box,
# but can only deliver to the email address you signed up to Resend with.
RESEND_API_KEY=
EMAIL_FROM="Nexus <onboarding@resend.dev>"

# Used to build links inside verification/reset emails
FRONTEND_URL=http://localhost:3000

# "Try Demo Account" button on the login page — a fixed, public login for
# recruiters/clients to explore the app without signing up. Its workspace
# is wiped and reseeded with fresh sample data on every login, so it's
# safe to leave enabled in production.
DEMO_USER_EMAIL=demo@nexus.com
DEMO_USER_PASSWORD=Demo@1234
